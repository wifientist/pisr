# ─────────────────────────────────────────────────────────────────────
# PISR — Property Install Status Report
#
# Everything PISR needs lives in this file. There is no database, no user
# accounts and no secret store: these credentials ARE the configuration.
#
# Copy to .env and fill it in. The container refuses to start if anything
# required is missing or malformed — that is deliberate. A process that boots
# and then 500s on every request is worse than one that says what is wrong.
# ─────────────────────────────────────────────────────────────────────

# ── RUCKUS ONE credentials (required) ────────────────────────────────
# From RUCKUS ONE: Administration -> Account Management -> API Credentials.
# The tenant id is the hex string in the RUCKUS ONE console URL.
R1_TENANT_ID=
R1_CLIENT_ID=
R1_SHARED_SECRET=

# Which RUCKUS ONE cloud this tenant lives on.
#   NA   -> api.ruckus.cloud        (default)
#   EU   -> api.eu.ruckus.cloud
#   ASIA -> api.asia.ruckus.cloud
# Note: ASIA, not APAC. Anything unrecognised silently resolves to NA inside
# the client, so config.py rejects it up front instead.
R1_REGION=NA

# EC  -> the credentials address one tenant; PISR reports on its venues.
# MSP -> the credentials address an MSP account, which owns no venues of its
#        own. The UI shows an MSP-EC picker first, and every read is scoped to
#        the chosen EC with the x-rks-tenantid header.
#
# Must be exactly EC or MSP. This is compared as a literal string in three
# places; a lowercase "msp" would silently drop the tenant header and report on
# the MSP's own venue-less tenant — an empty report with no error anywhere.
R1_EC_TYPE=EC

# ── Presentation (optional) ──────────────────────────────────────────
# Shown in the UI header and printed on the PDF cover. A tenant id is a hex
# string and reads badly on a document handed to a property manager.
R1_CONTROLLER_NAME=RUCKUS ONE

# The integer in /api/pisr/{id}/... — cosmetic, a vestige of rtools2's
# multi-controller routing. Change it only if you have a reason to; the UI
# learns the right value from /api/config either way.
R1_CONTROLLER_ID=1

# ── Serving (optional) ───────────────────────────────────────────────
# Which interface the app is published on. Empty means every interface, which
# is what makes it reachable from the rest of the LAN. Narrow it when only one
# network should see PISR at all — the VPN side, say, or this host only:
#   PISR_BIND=127.0.0.1
#   PISR_BIND=10.0.25.25
# This is a network control, not a substitute for the gate. Both, always.
PISR_BIND=

# Host port the whole app (SPA + API) is published on.
# Not 8080 by default: rtools2's dev nginx already binds that on the machine
# this was extracted from, and having both up at once is normal.
PISR_PORT=8090

# Extra browser origins allowed to call the API. Leave EMPTY for the normal
# single-container deployment: the SPA is served from the same origin as the
# API, so no CORS is involved at all. Only set this if you front PISR with a
# separate web server on a different origin.
CORS_ORIGINS=

# ── Diagnostics (optional) ───────────────────────────────────────────
LOG_LEVEL=INFO

# "1" logs every RUCKUS ONE request and response body. Read directly by
# r1api/client.py — do not rename it. Verbose, and it includes tenant data.
#
# Useful for two things: confirming x-rks-tenantid is present on MSP reads,
# and proving PISR is read-only (grep the log for anything that is not a GET
# or a POST to a */query path — there should be nothing).
R1_VERBOSE=0

# ── Dev compose only (docker-compose.dev.yml) ────────────────────────
# Not used by the single-container production deployment.
VITE_DEV_PORT=4173
API_DEV_PORT=4174
VITE_ALLOWED_HOSTS=localhost

# ── Access control (required) ────────────────────────────────────────
# PISR serves a full RUCKUS ONE venue inventory — AP serials, MACs, IP
# addressing, VLANs, SSIDs — to anyone who can reach its port. It refuses to
# start without a passphrase set here.
#
# One shared passphrase, exchanged once for a signed HttpOnly session cookie.
# Not a user system: no accounts, no roles, no per-person revocation. That is
# the right size for one tool pointed at one tenant, and the wrong size for
# anything on the public internet — put an identity-aware proxy in front if
# this ever leaves a network you trust.
#
# Minimum 10 characters (api/config.py:MIN_PASSPHRASE_LENGTH). The per-IP
# lockout below is what actually stops guessing; length is the backstop for the
# fact that the lockout resets when the container restarts.
#
# Two characters Compose will eat if you use them: `$` starts a variable
# reference and the rest is dropped, and surrounding quotes are stripped.
# Everything else — spaces, #, ', !, @, % — survives intact.
#
# Make it unique to this tool: it lives in this file in
# plaintext, next to the RUCKUS ONE shared secret, so a passphrase reused from
# somewhere else leaks that somewhere else too.
PISR_AUTH_PASSPHRASE=

# Signs the session cookie. Leave EMPTY and a random one is generated at
# startup — safe, but every restart signs everyone out. Set it to keep
# sessions across restarts:
#   openssl rand -base64 32
# Rotating it, or changing the passphrase above, invalidates every outstanding
# session immediately.
PISR_SESSION_SECRET=

# How long a session lasts before the passphrase is asked for again.
PISR_SESSION_HOURS=12

# Set to 1 when PISR is served over HTTPS, which marks the cookie Secure so a
# browser will not send it over plain HTTP. Leave 0 on a plain-HTTP LAN
# deployment — a Secure cookie is simply never sent there, which locks you out.
#
# Worth being clear-eyed about: over plain HTTP the passphrase and the cookie
# both cross the wire in the clear and anyone on that wire can read them. On a
# trusted office LAN that is a considered trade. It is not one to make on
# guest wifi.
PISR_COOKIE_SECURE=0

# Brute-force throttle, per source IP, held in memory (so it resets on
# restart). After MAX_ATTEMPTS wrong passphrases that IP is refused for
# LOCKOUT_SECONDS.
PISR_AUTH_MAX_ATTEMPTS=5
PISR_AUTH_LOCKOUT_SECONDS=300

# Set to 1 to remove the gate entirely. Only defensible when the port is bound
# to 127.0.0.1 and nothing else can reach it. There is no other way to run PISR
# open — that is deliberate.
PISR_AUTH_DISABLED=0

# ── Keeping secrets out of the container environment (optional) ──────
# Every setting above can instead be read from a file, by setting <NAME>_FILE
# to a path. The file wins when both are present.
#
#   R1_SHARED_SECRET_FILE=/run/secrets/r1_shared_secret
#   PISR_AUTH_PASSPHRASE_FILE=/run/secrets/pisr_passphrase
#
# This is what lets a secret arrive as a Docker Compose secret rather than an
# environment variable: `docker inspect` and /proc/1/environ print the
# environment, and do not print /run/secrets. See docker-compose.yml.

# ── SSO, when a shared passphrase stops being enough (optional) ───────
# PISR_AUTH_MODE=passphrase (the default) is everything above.
#
# PISR_AUTH_MODE=proxy hands authentication to a reverse proxy in front —
# oauth2-proxy against Entra, Okta or Google Workspace — which does the whole
# OIDC exchange and forwards the caller's identity in a header. PISR validates
# no tokens, holds no client secret and has no callback route. Switching is a
# compose change, not a code change.
#
# In this mode the passphrase is OFF and /api/login refuses. Two doors would
# make the shared secret a way around SSO, which throws away the audit trail
# and per-person revocation that were the reasons to adopt it.
PISR_AUTH_MODE=passphrase

# The header carrying the identity. oauth2-proxy emits this one when started
# with --set-xauthrequest; check what yours actually sends before trusting it.
PISR_TRUSTED_PROXY_HEADER=X-Forwarded-Email

# REQUIRED in proxy mode, and the whole security of it. A header is a claim,
# not proof: anyone who can open a socket to PISR can send
# `X-Forwarded-Email: someone.important@corp.example`. Only these source
# addresses are believed. Accepts IPs and CIDRs, comma-separated.
#
#   PISR_TRUSTED_PROXY_IPS=172.20.0.0/16
#
# This is the SECOND lock. The first is the port binding: in proxy mode,
# publish PISR on 127.0.0.1 or on the proxy's own Docker network — never on
# 0.0.0.0, or the proxy becomes a suggestion rather than a gate.
PISR_TRUSTED_PROXY_IPS=

# Where the "Sign out" control sends people. PISR cannot end an SSO session —
# the cookie belongs to the proxy — so without this the control becomes a
# label showing who you are signed in as. oauth2-proxy's is /oauth2/sign_out.
PISR_PROXY_LOGOUT_URL=
