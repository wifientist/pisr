[Unit]
Description=Pull and redeploy PISR if main has moved
Documentation=https://github.com/wifientist/pisr/blob/main/deploy/README.md
# Rootless podman talks to the user's own socket, so this needs the user
# session up. It is a --user unit; see deploy/README.md for enable-linger,
# without which the session ends at logout and the timer stops with it.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/app/deploy/pisr-update.sh

# LOAD-BEARING. Without it this unit kills the container it just deployed.
#
# podman-compose starts the container and returns, but it leaves conmon and
# rootlessport running — and because they were forked from here, they live in
# THIS unit's cgroup. systemd's default KillMode=control-group SIGTERMs, waits
# TimeoutStopSec, then SIGKILLs everything in that cgroup when the unit stops,
# which a oneshot does the moment its script exits. So a successful deploy
# reported success, and ninety seconds later systemd killed the container it
# had just brought up:
#
#   pisr-update.service: State 'stop-sigterm' timed out. Killing.
#   pisr-update.service: Killing process 3998 (rootlessport) with signal SIGKILL.
#
# KillMode=process confines the kill to the main process — the script, which
# has already exited — and leaves its descendants alone. The container survives
# the unit that started it, which is the entire point of `up -d`.
KillMode=process

# With KillMode=process there is nothing left to wait for, so a stop that takes
# more than a few seconds means something is wrong rather than something is
# slow. The old 90s default is what made the failure above take 90s to arrive.
TimeoutStopSec=15

# Settings live here rather than in the script so an operator changes the
# deployment without editing a tracked file — which would make the working
# tree dirty and stop the very script that reads it.
EnvironmentFile=-%h/.config/pisr-update.env

# A rebuild is slow and this is not urgent; keep it off the back of whatever
# else the box is doing.
Nice=10
IOSchedulingClass=idle

# The script writes nothing outside the app directory and the lock file.
PrivateTmp=false
NoNewPrivileges=true

TimeoutStartSec=900
